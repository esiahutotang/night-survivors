<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8">
<script>
// The runtime's own status/progress nodes remain available, but this UI owns
// its text and only reports byte progress for the actual game archive.
(() => {
    let phase = 'runtime', finished = false, failed = false;
    let loaded = 0, total = 0;
    const messages = {
        runtime: ['准备运行环境', '首次打开需要下载运行环境，之后会使用浏览器缓存。'],
        download: ['下载游戏资源', '正在下载角色、音效与每日挑战数据。'],
        unpack: ['解压游戏资源', '资源已下载，正在准备游戏文件。'],
        components: ['初始化游戏', '正在载入游戏组件，请稍候。'],
        ready: ['准备就绪', '点击开始，启用声音并进入游戏。']
    };
    const node = id => document.getElementById(id);
    function render() {
        if (!node('loading-screen')) return;
        node('loading-screen').hidden = finished;
        if (finished) return;
        const message = failed ? ['加载未完成', '请检查网络后重试；首次加载需要连接运行环境服务。'] : messages[phase];
        node('loading-status').textContent = message[0];
        node('loading-hint').textContent = message[1];
        const bar = node('loading-progress');
        bar.hidden = failed;
        if (!failed && phase === 'download' && total > 0 && loaded <= total) {
            bar.max = total;
            bar.value = loaded;
            node('loading-detail').textContent = `${Math.floor(loaded / total * 100)}% · ${(loaded / 1048576).toFixed(1)} / ${(total / 1048576).toFixed(1)} MB`;
        } else {
            bar.removeAttribute('value');
            node('loading-detail').textContent = phase === 'download' && loaded ? `已接收 ${(loaded / 1048576).toFixed(1)} MB` : '每日挑战 · 每天三个增益 / 减益词条';
        }
        if (phase === 'ready' && !failed) { bar.max = 1; bar.value = 1; }
        node('loading-action').hidden = !failed && phase !== 'ready';
        node('loading-action').textContent = failed ? '重新加载' : '点击开始';
    }
    window.NightLoader = {
        stage(next) {
            if (finished || failed || !messages[next]) return;
            phase = next;
            render();
        },
        complete() { if (failed) return; finished = true; render(); },
        fail() { if (finished) return; failed = true; render(); }
    };
    const nativeFetch = window.fetch.bind(window);
    window.fetch = async function(input, options) {
        const url = new URL(typeof input === 'string' || input instanceof URL ? input : input.url, location.href);
        const archive = url.origin === location.origin && /\/night-survivors\.(apk|tar\.gz)$/.test(url.pathname);
        if (!archive) return nativeFetch(input, options);
        window.NightLoader.stage('download');
        try {
            const response = await nativeFetch(input, options);
            if (!response.ok) throw new Error(`Game download: HTTP ${response.status}`);
            loaded = 0;
            // Encoded HTTP bodies can report a wire length unlike decoded bytes.
            total = response.headers.get('Content-Encoding') ? 0 : Number(response.headers.get('Content-Length')) || 0;
            if (!response.body || typeof ReadableStream === 'undefined') return response;
            const reader = response.body.getReader();
            const stream = new ReadableStream({
                async pull(controller) {
                    try {
                        const chunk = await reader.read();
                        if (chunk.done) {
                            controller.close();
                            window.NightLoader.stage('unpack');
                        } else {
                            loaded += chunk.value.byteLength;
                            render();
                            controller.enqueue(chunk.value);
                        }
                    } catch (error) {
                        window.NightLoader.fail();
                        controller.error(error);
                    }
                },
                cancel(reason) { return reader.cancel(reason); }
            });
            // A single stream: no second download or cloned, buffered response.
            return new Response(stream, {status: response.status, statusText: response.statusText, headers: response.headers});
        } catch (error) {
            window.NightLoader.fail();
            throw error;
        }
    };
    document.addEventListener('DOMContentLoaded', () => {
        render();
        node('loading-action').addEventListener('click', () => {
            if (failed) location.reload();
            // The original runtime listens to the same trusted click to unlock audio.
        });
    });
    window.addEventListener('error', event => {
        if (event.error || (event.target && event.target.id === 'site')) window.NightLoader.fail();
    }, true);
    window.addEventListener('unhandledrejection', () => window.NightLoader.fail());
    setTimeout(() => {
        if (!finished && !failed && phase !== 'ready' && node('loading-hint')) {
            node('loading-hint').textContent = '加载仍在进行。首次下载较慢，请保持网络连接；长时间无变化可刷新重试。';
        }
    }, 45000);
})();

</script>
